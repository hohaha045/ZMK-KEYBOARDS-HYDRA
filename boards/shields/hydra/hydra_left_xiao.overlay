#include "hydra.dtsi"

/* ── Matrix: override &pro_micro refs from hydra.dtsi ── */
/* ROW1-4 → XIAO D0-D3 (P0.02/P0.03/P0.28/P0.29) via adapter */
/* COL1-3 → XIAO D11-D13 (P0.15/P0.19/P1.01)  via adapter    */

&kscan_col2row {
    row-gpios
        = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW1 D0/P0.02
        , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW2 D1/P0.03
        , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW3 D2/P0.28
        , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW4 D3/P0.29
        ;
    col-gpios
        = <&gpio0 15 GPIO_ACTIVE_HIGH>  // COL1 D11/P0.15
        , <&gpio0 19 GPIO_ACTIVE_HIGH>  // COL2 D12/P0.19
        , <&gpio1  1 GPIO_ACTIVE_HIGH>  // COL3 D13/P1.01
        ;
};

&kscan_row2col {
    row-gpios
        = <&xiao_d 0 GPIO_ACTIVE_HIGH>  // ROW1 D0/P0.02
        , <&xiao_d 1 GPIO_ACTIVE_HIGH>  // ROW2 D1/P0.03
        , <&xiao_d 2 GPIO_ACTIVE_HIGH>  // ROW3 D2/P0.28
        , <&xiao_d 3 GPIO_ACTIVE_HIGH>  // ROW4 D3/P0.29
        ;
    col-gpios
        = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // COL1 D11/P0.15
        , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // COL2 D12/P0.19
        , <&gpio1  1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // COL3 D13/P1.01
        ;
};

/* ── Encoder: D17/P1.03=A, D18/P1.05=B (Plus-only pins) ── */
&left_encoder {
    status = "okay";
    a-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // D17/P1.03
    b-gpios = <&gpio1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // D18/P1.05
};

/* ── I2C pinctrl: D4=SDA/P0.04, D5=SCL/P0.05 ── */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,   // D4/P0.04 → JP16 → SENS_SDA
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;    // D5/P0.05 → JP15 → SENS_SCL
            bias-pull-up;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    glidepoint: glidepoint@2a {
        compatible = "cirque,pinnacle";
        status = "okay";
        reg = <0x2a>;
        data-ready-gpios = <&xiao_d 9 (GPIO_ACTIVE_HIGH)>;  // D9/P1.14 DR
        idle-packets-count = <0>;
        sensitivity = "4x";
        primary-tap-enable;
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            device = <&glidepoint>;
            reg = <0>;
        };
    };
};
