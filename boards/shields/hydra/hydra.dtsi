#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/behaviors.h>
#include "hydra-layouts.dtsi"

&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;  // 3 physical cols per side
        rows = <8>;     // 4 col2row rows + 4 row2col rows (Japanese Duplex)

        // Visual layout per row (5 keys: col2row, row2col, col2row, row2col, col2row)
        // Left cols 0-2, Right cols 3-5 (via col-offset=3 in right overlay)
        // col2row keys  → RC(row,   col)
        // row2col keys  → RC(row+4, col)  [row-offset=4 in composite]

        map = <
            // Left side
            RC(0,0) RC(4,0) RC(0,1) RC(4,1) RC(0,2)   // ROW1: S1  S2  S3  S4  S5
            RC(1,0) RC(5,0) RC(1,1) RC(5,1) RC(1,2)   // ROW2: S6  S7  S8  S9  S10
            RC(2,0) RC(6,0) RC(2,1) RC(6,1) RC(2,2)   // ROW3: S11 S12 S13 S14 S15
            RC(3,0) RC(7,0) RC(3,1) RC(7,1) RC(3,2)   // ROW4: S16 S17 S18 S19 S20
            // Right side
            RC(0,3) RC(4,3) RC(0,4) RC(4,4) RC(0,5)   // ROW1: S21 S22 S23 S24 S25
            RC(1,3) RC(5,3) RC(1,4) RC(5,4) RC(1,5)   // ROW2: S26 S27 S28 S29 S30
            RC(2,3) RC(6,3) RC(2,4) RC(6,4) RC(2,5)   // ROW3: S31 S32 S33 S34 S35
            RC(3,3) RC(7,3) RC(3,4) RC(7,4) RC(3,5)   // ROW4: S36 S37 S38 S39 S40
        >;
    };

    kscan_col2row: kscan_col2row {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1 D20
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW2 D19
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW3 D18
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW4 D15
            ;
        // col-gpios added by each side overlay
    };

    kscan_row2col: kscan_row2col {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";
        // ROW pins are OUTPUTS in row2col — GPIO_ACTIVE_HIGH only, no pull
        row-gpios
            = <&pro_micro 20 GPIO_ACTIVE_HIGH> // ROW1 D20
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> // ROW2 D19
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> // ROW3 D18
            , <&pro_micro 15 GPIO_ACTIVE_HIGH> // ROW4 D15
            ;
        // COL pins are INPUTS in row2col — (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) added by each side overlay
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        wakeup-source;
        rows = <8>;
        columns = <3>;

        kscan_c2r {
            kscan = <&kscan_col2row>;
        };
        kscan_r2c {
            kscan = <&kscan_row2col>;
            row-offset = <4>;
        };
    };

    behaviors {
        htp: hold_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap preffered hold-tap";
        };
    };

    left_encoder: encoder_left {
        label = "LEFT_ENCODER";
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Pin A
        b-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Pin B
        steps = <20>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

};
