#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/behaviors.h>
#include "hydra-layouts.dtsi"

&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;  // 3 physical cols per side
        rows = <8>;     // 4 col2row rows + 4 row2col rows (Japanese Duplex)

            // | SW3  | SW6  | SW9  | SW12 | SW15 |                     | SW33 | SW30 | SW27 | SW24 | SW21 |
            // | SW2  | SW5  | SW8  | SW11 | SW14 |                     | SW32 | SW29 | SW26 | SW23 | SW20 |
            // | SW1  | SW4  | SW7  | SW10 | SW13 |                     | SW31 | SW28 | SW25 | SW22 | SW19 |
            // | SW16 | SW17 | SW18 |                                                 | SW36 | SW35 | SW34 |
            //
            // Duplex mapping: odd visual cols (1,3,5) = col2row RC(row,col)
            //                 even visual cols (2,4)   = row2col RC(row+4,col)
            //                 thumb row = 3 col2row keys only

        map = <
            // Left side (col-offset = 0)
            RC(0,0) RC(4,0) RC(0,1) RC(4,1) RC(0,2)
            RC(1,0) RC(5,0) RC(1,1) RC(5,1) RC(1,2)
            RC(2,0) RC(6,0) RC(2,1) RC(6,1) RC(2,2)
            RC(3,0) RC(3,1) RC(3,2)
            // Right side (col-offset = 3 set in hydra_right.overlay)
            RC(0,3) RC(4,3) RC(0,4) RC(4,4) RC(0,5)
            RC(1,3) RC(5,3) RC(1,4) RC(5,4) RC(1,5)
            RC(2,3) RC(6,3) RC(2,4) RC(6,4) RC(2,5)
            RC(3,3) RC(3,4) RC(3,5)
        >;
    };

    kscan_col2row: kscan_col2row {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1 D20
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW2 D19
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW3 D18
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW4 D15
            ;
        // col-gpios added by each side overlay
    };

    kscan_row2col: kscan_row2col {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";
        row-gpios
            = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1 D20
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW2 D19
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW3 D18
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW4 D15
            ;
        // col-gpios added by each side overlay
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <8>;
        columns = <3>;

        kscan_c2r {
            kscan = <&kscan_col2row>;
        };
        kscan_r2c {
            kscan = <&kscan_row2col>;
            row-offset = <4>;
        };
    };

    behaviors {
        htp: hold_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap preffered hold-tap";
        };
    };

    left_encoder: encoder_left {
        label = "LEFT_ENCODER";
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Pin A
        b-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Pin B
        steps = <20>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

};
