/* Shared DTSI for XIAO BLE Plus adapter variants.
 * Uses &xiao_d nexus and raw GPIO refs instead of &pro_micro.
 * Do NOT include hydra.dtsi alongside this file.
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/behaviors.h>
#include "hydra-layouts.dtsi"

&physical_layout0 {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <8>;

        map = <
            // Left side
            RC(0,0) RC(4,0) RC(0,1) RC(4,1) RC(0,2)
            RC(1,0) RC(5,0) RC(1,1) RC(5,1) RC(1,2)
            RC(2,0) RC(6,0) RC(2,1) RC(6,1) RC(2,2)
            RC(3,0) RC(7,0) RC(3,1) RC(7,1) RC(3,2)
            // Right side
            RC(0,3) RC(4,3) RC(0,4) RC(4,4) RC(0,5)
            RC(1,3) RC(5,3) RC(1,4) RC(5,4) RC(1,5)
            RC(2,3) RC(6,3) RC(2,4) RC(6,4) RC(2,5)
            RC(3,3) RC(7,3) RC(3,4) RC(7,4) RC(3,5)
        >;
    };

    kscan_col2row: kscan_col2row {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        // ROW1-4 → XIAO D0-D3 via adapter
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D0/P0.02
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D1/P0.03
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D2/P0.28
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D3/P0.29
            ;
        // col-gpios added by each side overlay
    };

    kscan_row2col: kscan_row2col {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";
        row-gpios
            = <&xiao_d 0 GPIO_ACTIVE_HIGH>  // D0/P0.02
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>  // D1/P0.03
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>  // D2/P0.28
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>  // D3/P0.29
            ;
        // col-gpios added by each side overlay
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        wakeup-source;
        rows = <8>;
        columns = <3>;

        kscan_c2r {
            kscan = <&kscan_col2row>;
        };
        kscan_r2c {
            kscan = <&kscan_row2col>;
            row-offset = <4>;
        };
    };

    behaviors {
        htp: hold_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
            display-name = "Tap preffered hold-tap";
        };
    };

    // Encoder on XIAO Plus D17/P1.03=A, D18/P1.05=B (not in standard xiao_d nexus)
    left_encoder: encoder_left {
        label = "LEFT_ENCODER";
        compatible = "alps,ec11";
        a-gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // D17/P1.03
        b-gpios = <&gpio1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // D18/P1.05
        steps = <20>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
};
