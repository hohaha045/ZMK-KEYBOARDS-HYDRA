#include "hydra.dtsi"

&kscan0 {
    col-gpios
        = <&pro_micro 18 GPIO_ACTIVE_HIGH> // PINKY
        , <&pro_micro 15 GPIO_ACTIVE_HIGH> // RING
        , <&pro_micro 14 GPIO_ACTIVE_HIGH> // MIDDLE
        , <&pro_micro 16 GPIO_ACTIVE_HIGH> // INDEX
        , <&pro_micro 10 GPIO_ACTIVE_HIGH> // INNER
        ;
};

&left_encoder { status = "okay"; };

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 04)>,
                <NRF_PSEL(TWIM_SCL, 0, 11)>;
            bias-pull-up;
        };
    };
    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 04)>,
                <NRF_PSEL(TWIM_SCL, 0, 11)>;
            low-power-enable;
        };
    };
};

&pro_micro_i2c {
    status = "okay";
    glidepoint: glidepoint@2a {
        compatible = "cirque,pinnacle";
        status = "okay";
        reg = <0x2a>;
        data-ready-gpios = <&pro_micro 6 (GPIO_ACTIVE_HIGH)>;
        idle-packets-count = <0>;
        sensitivity = "4x";
        primary-tap-enable;
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            device = <&glidepoint>;
            reg = <0>;
        };
    };
};
